<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
    	<groupId>net.sf.exlp</groupId>
    	<artifactId>exlp</artifactId>
    	<version>0.1.18-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
	</parent>
	
    <artifactId>exlp-xml</artifactId>
    <packaging>pom</packaging>
    <name>ExLP - XML</name>

	<properties>
		<!-- Each JAXB variant compiles and packages in its own output directory; neither is privileged -->
		<xml.classes.javax>${project.build.directory}/classes-javax</xml.classes.javax>
		<xml.classes.jakarta>${project.build.directory}/classes-jakarta</xml.classes.jakarta>
	</properties>

	<dependencyManagement>
		<dependencies>       	         
			<dependency>
				<groupId>net.sf.exlp</groupId>
				<artifactId>exlp-bom</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
    
    <dependencies>
		<dependency>
   			<groupId>net.sf.exlp</groupId>
   			<artifactId>exlp-interfaces</artifactId>
   			<type>jar</type>
   			<scope>compile</scope>
   		</dependency>

		<!-- Jakarta EE -->
    	<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<version>4.0.0</version>
			<scope>provided</scope>
		</dependency>
		
		<!-- Java EE -->
       	<dependency>
			<groupId>javax.xml.bind</groupId>
			<artifactId>jaxb-api</artifactId>
    		<type>jar</type>
    		<version>2.3.1</version>
    		<scope>provided</scope>
		</dependency>
		
		<!-- JSON -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
		   <groupId>com.fasterxml.jackson.datatype</groupId>
		   <artifactId>jackson-datatype-jsr310</artifactId>
		   <version>2.15.2</version>
		   <scope>provided</scope>
		</dependency>

	</dependencies>
    
	<build>
		<plugins>
			<!-- One compilation per JAXB variant; the module publishes no main artifact -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<!-- compileSourceRoots/outputDirectory are write-only parameters from 3.13.0 on; version follows the parent -->
				<version>${maven-compiler-plugin.version}</version>
				<executions>
					<execution>
						<id>compile-javax</id>
						<phase>compile</phase>
						<goals><goal>compile</goal></goals>
						<configuration>
							<release>8</release>
							<outputDirectory>${xml.classes.javax}</outputDirectory>
							<compileSourceRoots>
								<compileSourceRoot>${project.basedir}/src/main/java</compileSourceRoot>
								<compileSourceRoot>${project.basedir}/src/main/javax</compileSourceRoot>
							</compileSourceRoots>
						</configuration>
					</execution>
					<execution>
						<id>compile-jakarta</id>
						<phase>compile</phase>
						<goals><goal>compile</goal></goals>
						<configuration>
							<release>11</release>
							<outputDirectory>${xml.classes.jakarta}</outputDirectory>
							<compileSourceRoots>
								<compileSourceRoot>${project.basedir}/src/main/java</compileSourceRoot>
								<compileSourceRoot>${project.basedir}/src/main/jakarta</compileSourceRoot>
							</compileSourceRoots>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- Reachability metadata for the JAXB and JSON models (FR-001), one run per variant -->
			<plugin>
				<groupId>net.sf.exlp</groupId>
				<artifactId>exlp-maven</artifactId>
				<version>${project.version}</version>
				<executions>
					<execution>
						<id>reachability-metadata-javax</id>
						<phase>process-classes</phase>
						<goals><goal>reachabilityMetadata</goal></goals>
						<configuration><outputDirectory>${xml.classes.javax}</outputDirectory></configuration>
					</execution>
					<execution>
						<id>reachability-metadata-jakarta</id>
						<phase>process-classes</phase>
						<goals><goal>reachabilityMetadata</goal></goals>
						<configuration><outputDirectory>${xml.classes.jakarta}</outputDirectory></configuration>
					</execution>
				</executions>
				<configuration>
					<annotations>
						<annotation>javax.xml.bind.annotation.XmlAccessorType</annotation>
						<annotation>jakarta.xml.bind.annotation.XmlAccessorType</annotation>
						<annotation>com.fasterxml.jackson.annotation.JsonRootName</annotation>
					</annotations>
				</configuration>
			</plugin>
			<!-- The classifier jars are the artifacts of the module -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<id>jar-javax</id>
						<phase>process-classes</phase>
						<goals><goal>jar</goal></goals>
						<configuration>
							<classifier>javax</classifier>
							<classesDirectory>${xml.classes.javax}</classesDirectory>
						</configuration>
					</execution>
					<execution>
						<id>jar-jakarta</id>
						<phase>process-classes</phase>
						<goals><goal>jar</goal></goals>
						<configuration>
							<classifier>jakarta</classifier>
							<classesDirectory>${xml.classes.jakarta}</classesDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
		        <groupId>org.apache.maven.plugins</groupId>
		        <artifactId>maven-pmd-plugin</artifactId>
		        <configuration>
			        <excludes>
			            <exclude>net/sf/exlp/xml/config/*.java</exclude>
			            <exclude>net/sf/exlp/xml/identity/*.java</exclude>
			            <exclude>net/sf/exlp/xml/io/*.java</exclude>
			            <exclude>net/sf/exlp/xml/net/*.java</exclude>
			            <exclude>net/sf/exlp/xml/ns/*.java</exclude>
					</excludes>
	        </configuration>
			</plugin>
		</plugins>
	</build>
	
	<profiles>
		<profile>
			<id>javax</id>
			<build>
				<plugins>
					<plugin>
	        		<groupId>org.apache.cxf</groupId>
	    			<artifactId>cxf-xjc-plugin</artifactId>
	    			<version>3.3.2</version>
	    			<executions>
	        			<execution> 
	            			<id>xjc</id>
	            			<phase>generate-sources</phase>
	            			<goals><goal>xsdtojava</goal></goals>
	  	        			<configuration>
								<sourceRoot>${basedir}/src/main/javax</sourceRoot>
	                			<xsdOptions>
	                    			<xsdOption>
										<bindingFile>${basedir}/src/main/xsd/javax.xjb</bindingFile>
										<extensionArgs><arg>-encoding</arg><arg>UTF-8</arg><arg>-no-header</arg></extensionArgs>
	                        			<xsd>${basedir}/src/main/xsd/xsd.xsd</xsd>
	                    			</xsdOption>
	                			</xsdOptions>
	            			</configuration>
	        			</execution>
	    			</executions>                    
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>jakarta</id>
			<build>
				<plugins>
					<plugin>
                		<groupId>org.apache.cxf</groupId>
            			<artifactId>cxf-xjc-plugin</artifactId>
            			<version>4.0.0</version>
            			<executions>
                			<execution>
                    			<id>xjc</id>
                    			<phase>generate-sources</phase>
                    			<goals><goal>xsdtojava</goal></goals>
          	        			<configuration>
									<sourceRoot>${basedir}/src/main/jakarta</sourceRoot>
                        			<xsdOptions>
                            			<xsdOption>
											<bindingFile>${basedir}/src/main/xsd/jakarta.xjb</bindingFile>
											<extensionArgs><arg>-encoding</arg><arg>UTF-8</arg><arg>-no-header</arg></extensionArgs>
	                        				<xsd>${basedir}/src/main/xsd/xsd.xsd</xsd>
	                    				</xsdOption>
                        			</xsdOptions>
                    			</configuration>
                			</execution>
            			</executions>                    
           			</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
